# Copy this file to .env and fill in the values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Production settings (defaults suit local development).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL connection string; SQLite is used when empty.
DATABASE_URL=

# Stellar wallet payments (optional). The testnet contract is listed in
# blockchain/deployments/testnet.json. Leave empty to disable.
STELLAR_CONTRACT_ID=
# Secret key (S...) of the contract admin, used by Django admin actions.
STELLAR_ADMIN_SECRET=
